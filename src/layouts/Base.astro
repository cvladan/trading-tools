---
import '../styles/global.css';
import aiNotice from '../scripts/ai-notice.js?raw';
import { repository, sourceDirectory } from '../lib';
interface Props { title?: string; description?: string; noindex?: boolean; errorPage?: boolean; navigationPath?: string; structuredData?: Record<string, unknown>[]; }
const { title='Trading tools for TradingView and CFD brokers', description='TradingView indicators for CFD charts, desktop browser userscripts and Trade Nation utilities. Read setup guides and inspect the source code.', noindex=false, errorPage=false, navigationPath=Astro.url.pathname, structuredData=[] } = Astro.props;
const path=Astro.url.pathname;
const current=(href: string)=>navigationPath===href?(path===href?'page':'true'):undefined;
const pageTitle=path==='/'?title:`${title} · Trading tools`;
const canonical=new URL(path, Astro.site).href;
const image=new URL('/social-preview.png', Astro.site).href;
const imageAlt='Trading tools for TradingView and CFD brokers. Indicators, browser userscripts and setup guides.';
const schema=path==='/'?[{'@type':'WebSite',name:'Trading tools',url:Astro.site?.href,inLanguage:'en-GB'},...structuredData]:structuredData;
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
{import.meta.env.PROD&&<>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JH4M2ZS15M"></script>
<script is:inline>
 window.dataLayer = window.dataLayer || [];
 function gtag(){dataLayer.push(arguments);}
 gtag('js', new Date());
 gtag('config', 'G-JH4M2ZS15M');
</script>
</>}
<title>{pageTitle}</title>
<meta name="description" content={description}/><meta name="theme-color" content="#0d1118"/>
{noindex&&<meta name="robots" content="noindex, follow"/>}
{!errorPage&&<link rel="canonical" href={canonical}/>}<link rel="icon" href="data:,"/>
<meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{!errorPage&&<meta property="og:url" content={canonical}/>}
<meta property="og:site_name" content="Trading tools"/><meta property="og:locale" content="en_GB"/>
<meta property="og:image" content={image}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={imageAlt}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content={imageAlt}/>
{schema.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':schema}).replaceAll('<','\\u003c')}/>}
<script is:inline>try{if(localStorage.getItem('trading-tools-theme')==='light')document.documentElement.dataset.theme='light'}catch{}</script>
<script is:inline set:html={aiNotice}/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="nav-wrap section-shell"><a href="/" class="brand" aria-label="Trading tools home"><span>Trading tools<small>for TradingView and CFD brokers</small></span></a><nav aria-label="Main navigation"><a href="/indicators/" aria-current={current('/indicators/')}>TradingView Indicators</a><a href="/userscripts/tradingview/" aria-current={current('/userscripts/tradingview/')}>TradingView User Scripts</a><a href="/userscripts/trade-nation/" aria-current={current('/userscripts/trade-nation/')}>Trade Nation User Scripts</a><a href="/tools/trading-statistics/" aria-current={current('/tools/trading-statistics/')}>Trading Statistics</a></nav><div class="nav-actions"><button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button></div></div></header>
<aside class="ai-notice section-shell" aria-label="About the use of AI">
 <div class="ai-notice-content"><p>Built with AI and 40 years of software engineering experience to be useful, not AI slop.</p><button type="button" data-dismiss-ai-notice aria-label="Dismiss AI notice"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
</aside>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="section-shell">
 <div class="footer-main">
  <div class="footer-identity"><a href="/" class="brand" aria-label="Trading tools home"><span>Trading tools<small>for TradingView and CFD brokers</small></span></a><a class="button secondary footer-source" href={sourceDirectory}>Source code <span aria-hidden="true">↗</span></a></div>
  <nav class="footer-links" aria-label="Tool catalogues"><h2>Tools</h2><a href="/indicators/">TradingView Indicators</a><a href="/userscripts/tradingview/">TradingView User Scripts</a><a href="/userscripts/trade-nation/">Trade Nation User Scripts</a><a href="/tools/trading-statistics/">Trading Statistics</a></nav>
  <nav class="footer-links" aria-label="Guides and contributions"><h2>Guides & contributions</h2><a href="/install/">Installation guide</a><a href="/about/">About the tools</a><a href={`${repository}/issues`}>Report an issue <span aria-hidden="true">↗</span></a><a href={`${repository}/pulls`}>Propose a change <span aria-hidden="true">↗</span></a></nav>
  <section class="footer-licence" aria-labelledby="footer-licence-heading"><h2 id="footer-licence-heading">Open source + commercial licence</h2><p>Free personal use, including trading for your own profit. Company and work use require a paid agreement.</p><p>Source available; not an OSI open-source licence.</p><a href="/licensing/">Licence terms & enquiries <span aria-hidden="true">↗</span></a></section>
 </div>
 <div class="footer-bottom"><span>© {new Date().getFullYear()} Vladan Colovic · SVKO</span><p>Independent tools. Not affiliated with TradingView, IG or Trade Nation. Illustrations use example data.</p></div>
</div></footer>
<script>
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const theme=document.querySelector<HTMLButtonElement>('.theme-toggle');
 theme?.addEventListener('click',()=>{const light=document.documentElement.dataset.theme!=='light';document.documentElement.dataset.theme=light?'light':'dark';try{localStorage.setItem('trading-tools-theme',light?'light':'dark')}catch{};theme.setAttribute('aria-label',`Switch to ${light?'dark':'light'} theme`)});
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}}},{threshold:.08});
 document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));
 document.querySelectorAll<HTMLButtonElement>('button.watch-row,button.watch-badge').forEach(button=>button.addEventListener('click',()=>button.setAttribute('aria-pressed',String(button.classList.toggle('show-price')))));
 const finePointer=matchMedia('(hover: hover) and (pointer: fine)');
 document.addEventListener('pointermove',event=>{
  if(reduced.matches||!finePointer.matches||event.pointerType!=='mouse')return;
  for(const target of event.composedPath()){
   if(!(target instanceof HTMLElement)||!target.matches('.hero,.tool-card,.visual:not(.compact),.setup-strip,.open-source-panel'))continue;
   const rect=target.getBoundingClientRect();
   target.style.setProperty('--pointer-x',`${event.clientX-rect.left}px`);
   target.style.setProperty('--pointer-y',`${event.clientY-rect.top}px`);
  }
 },{passive:true});
</script>
</body></html>
