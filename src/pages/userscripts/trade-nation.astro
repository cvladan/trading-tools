---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import {getCollection} from 'astro:content';
import {catalogueSchema} from '../../lib';
const tools=(await getCollection('tools')).filter(t=>t.data.group==='broker').sort((a,b)=>a.data.order-b.data.order);
---
<Base title="Trade Nation browser userscripts" description="Manual trading shortcuts and a position overlay for supported Trade Nation chart pages. Read the Hotkeys setup and browser requirements." structuredData={[catalogueSchema('Trade Nation userscripts',tools,Astro.url.pathname,Astro.site!)]}>
<section class="section-shell page-intro"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/userscripts/">Userscripts</a><span>/</span><span aria-current="page">Trade Nation</span></nav><div class="eyebrow">TRADE NATION / DESKTOP BROWSER</div><h1>Trade Nation userscripts.</h1><p class="lead">Add manual trading shortcuts and a position overlay to supported broker chart pages. Hotkeys also supports the documented TradeDirect365 pages.</p><div class="jump-links"><a href="/install/">Installation guide ↗</a></div><div class="notice"><div><strong>Review the setup before using shortcuts.</strong><p>Hotkeys requires a desktop browser and userscript manager. Follow its documented Firefox or Chrome and Violentmonkey setup, and start on a demo account.</p></div></div></section>
<section class="section-shell section-space"><h2>Trading shortcuts</h2><div class="tool-grid two">{tools.map(tool=><ToolCard tool={tool}/>)}</div></section>
</Base>
