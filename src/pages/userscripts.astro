---
import Base from '../layouts/Base.astro';import ToolCard from '../components/ToolCard.astro';import {getCollection} from 'astro:content';
import { catalogueSchema } from '../lib';
const tools=(await getCollection('tools')).sort((a,b)=>a.data.order-b.data.order);
---
<Base structuredData={[catalogueSchema('Browser userscripts', tools.filter(t=>t.data.group!=='indicator'), Astro.url.pathname, Astro.site!)]} title="Userscripts for TradingView and Trade Nation" description="Practical enhancements for TradingView in a desktop browser, plus Trade Nation shortcuts and trading statistics.">
<section class="section-shell page-intro"><div class="eyebrow">USERSCRIPTS / YOUR BROWSER WORKSPACE</div><h1>Customise TradingView.<br/><span>Add broker shortcuts.</span></h1><p class="lead">Rename TradingView tabs, open charts from ticker text, prepare AI questions and see watchlist prices on hover. Trade Nation tools add manual order shortcuts and a local trading history archive.</p><div class="jump-links"><a href="#tradingview">TradingView (browser) ↘</a><a href="#trade-nation">Trade Nation ↘</a><a href="/install/">Installation guide ↗</a></div></section>
<section class="section-shell"><div class="notice"><span class="notice-icon" aria-hidden="true">i</span><div><strong>A desktop browser and a userscript manager.</strong><p>Read the documentation on any device; install and use these tools on desktop. The TradingView tools enhance the website in your browser. They are not Pine indicators and do not run inside the native TradingView Desktop app. Edge or Chrome with Tampermonkey is the current workflow; check each tool's documented setup.</p></div></div></section>
<section id="tradingview" class="section-shell section-space"><div class="section-heading"><div><div class="eyebrow">01 / TRADINGVIEW (BROWSER)</div><h2>Tabs, ticker links,<br/>AI questions and watchlists.</h2></div><a href="/about/#browser" class="text-link">Why I use a dedicated browser ↗</a></div><div class="tool-grid two">{tools.filter(t=>t.data.group==='tradingview').map(tool=><ToolCard tool={tool}/>)}</div></section>
<section id="trade-nation" class="section-shell section-space border-top"><div class="section-heading"><div><div class="eyebrow">02 / TRADE NATION</div><h2>Place trades with hotkeys.<br/>Review your trading history.</h2></div><p>Manual chart shortcuts and a local history archive. Statistics imports Trade Nation CFD and Spread USD accounts. IG import is not implemented.</p></div><div class="tool-grid two">{tools.filter(t=>t.data.group==='broker').map(tool=><ToolCard tool={tool}/>)}</div></section>
</Base>
