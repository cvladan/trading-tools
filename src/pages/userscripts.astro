---
import Base from '../layouts/Base.astro';import ToolCard from '../components/ToolCard.astro';import {getCollection} from 'astro:content';
import { catalogueSchema } from '../lib';
const tools=(await getCollection('tools')).sort((a,b)=>a.data.order-b.data.order);
---
<Base structuredData={[catalogueSchema('Browser userscripts', tools.filter(t=>t.data.group!=='indicator'), Astro.url.pathname, Astro.site!)]} title="Userscripts for TradingView and Trade Nation" description="Practical enhancements for TradingView in a desktop browser, plus Trade Nation shortcuts and trading statistics.">
<section class="section-shell page-intro"><div class="eyebrow">USERSCRIPTS / CHOOSE YOUR PLATFORM</div><h1>Userscripts for TradingView<br/><span>and Trade Nation.</span></h1><p class="lead">Enhance TradingView in your browser, or add trading shortcuts and a history archive for Trade Nation.</p><div class="jump-links"><a href="#tradingview">TradingView (browser) ↘</a><a href="#trade-nation">Trade Nation ↘</a><a href="/install/">Installation guide ↗</a></div></section>
<section class="section-shell"><div class="notice"><span class="notice-icon" aria-hidden="true">i</span><div><strong>Install in a desktop browser.</strong><p>These are userscripts, not Pine indicators. They need a userscript manager such as Tampermonkey. Read the documentation on any device and check each tool's browser and manager requirements before installing.</p></div></div></section>
<section id="tradingview" class="section-shell section-space" aria-labelledby="tradingview-heading"><div class="section-heading platform-heading"><div><div class="eyebrow">CHART CUSTOMISATION</div><h2 id="tradingview-heading">TradingView</h2><p>For the TradingView website in your desktop browser. Customise tabs, ticker links, AI questions and watchlists. These tools do not run inside the native TradingView Desktop app.</p></div><a href="/about/#browser" class="text-link">Why I use a dedicated browser ↗</a></div><div class="tool-grid two">{tools.filter(t=>t.data.group==='tradingview').map(tool=><ToolCard tool={tool}/>)}</div></section>
<section id="trade-nation" class="section-shell section-space border-top" aria-labelledby="trade-nation-heading"><div class="section-heading platform-heading"><div><div class="eyebrow">BROKER TOOLS</div><h2 id="trade-nation-heading">Trade Nation</h2><p>Hotkeys work on supported Trade Nation chart pages. Trading Statistics collects history from Trade Nation CFD and Spread USD accounts. View its saved archive on another HTTPS page. There is no IG importer.</p></div></div><div class="tool-grid two">{tools.filter(t=>t.data.group==='broker').map(tool=><ToolCard tool={tool}/>)}</div></section>
</Base>
