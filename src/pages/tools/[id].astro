---
import {getCollection,render} from 'astro:content';import Base from '../../layouts/Base.astro';import Visual from '../../components/Visual.astro';import {repository,sourceUrl,groupLabel} from '../../lib';
export async function getStaticPaths(){return (await getCollection('tools')).map(tool=>({params:{id:tool.id},props:{tool}}));}
const {tool}=Astro.props;const {Content,headings}=await render(tool);const d=tool.data;const all=await getCollection('tools');const related=d.related.map(id=>all.find(t=>t.id===id)).filter(Boolean);
---
<Base title={d.name} description={d.summary}>
<section class="section-shell tool-intro"><div class="breadcrumbs"><a href={d.group==='indicator'?'/indicators/':'/userscripts/'}>{d.group==='indicator'?'Indicators':'Userscripts'}</a><span>/</span><span>{d.name.replace('SVKO ','')}</span></div><div class="eyebrow">{groupLabel(d.group)} / {d.label}</div><h1>{d.title}</h1><p class="lead">{d.summary}</p><div class="tool-tags"><span>{d.name}</span>{d.markets.map(m=><span>{m}</span>)}<span class="source-tag">Open source · {d.licence}</span></div><div class="button-row"><a class="button primary" href="#setup">{d.group==='indicator'?'Add to your chart':'Install the userscript'} <span aria-hidden="true">↘</span></a><a href={sourceUrl(d.source)} class="button secondary">View source <span aria-hidden="true">↗</span></a></div></section>
<section class="section-shell tool-demo" id="example"><Visual kind={d.visual} capture={d.capture}/></section>
<section class="section-shell tool-body"><aside class="page-toc"><div class="mini-label">ON THIS PAGE</div>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#setup">Get started</a><a href="#source">Source & contributions</a></aside><div class="tool-reading"><article class="prose"><Content/></article><section class="installation" id="setup"><div class="eyebrow">GET STARTED</div><h2>{d.group==='indicator'?'Add it to TradingView.':'Install it in your desktop browser.'}</h2>{d.group!=='indicator'&&<p class="install-context">Read this guide on any device; install and use the script on desktop. Requires a desktop browser with a userscript manager. {d.group==='tradingview'?'Runs on the TradingView website, not inside TradingView Desktop.':'Runs on the documented broker pages; check the tool-specific requirements above.'}</p>}{d.group==='indicator'&&<p class="install-context">Set up on desktop for the workflow documented here. TradingView mobile can render Pine indicators, but the author has not reviewed or tested their mobile output. You can read these guides and browse the source on a phone.</p>}<ol>{d.install.map(step=><li>{step}</li>)}</ol><div class="button-row">{d.publication?<a class="button primary" href={d.publication} target="_blank" rel="noreferrer">Open on TradingView ↗</a>:<a class="button primary desktop-install-link" href={`/sources/${encodeURIComponent(d.source)}`} download>Download userscript ↓</a>}{d.group!=='indicator'&&<a class="button primary mobile-source-link" href={sourceUrl(d.source)}>Read source · install on desktop ↗</a>}<a class="text-link" href={d.group==='indicator'?'/tools/symbol-mapper/':'/install/'}>{d.group==='indicator'?'Mapper setup':'Browser installation guide'} ↗</a></div>{d.group==='indicator'&&<p class="small-copy">The source copy is also available on GitHub. Publication versions can differ; review the source before using a local version.</p>}</section><section class="source-panel" id="source"><div><span class="eyebrow">OPEN SOURCE / {d.licence}</span><h2>Source code and contributions</h2><p>Use the source to understand the tool, report a problem or propose a focused change. Keep its licence and existing notices.</p></div><div class="source-links"><a href={sourceUrl(d.source)}>Read the source ↗</a><a href={`${repository}/issues/new?title=${encodeURIComponent(d.name+': ')}`}>Report an issue ↗</a><a href={`${repository}/pulls`}>Propose a change ↗</a></div></section></div></section>
{related.length>0&&<section class="section-shell related-section"><div class="eyebrow">USEFUL ALONGSIDE THIS TOOL</div><div class="related-links">{related.map(t=>t&&<a href={`/tools/${t.id}/`}><span>{t.data.label}</span><b>{t.data.name.replace('SVKO ','')} ↗</b></a>)}</div></section>}
</Base>
