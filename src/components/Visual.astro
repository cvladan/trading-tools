---
interface Props { kind: string; diagram?: string; capture?: string; compact?: boolean; }
const { kind, diagram, capture, compact = false } = Astro.props;
const chart = kind === 'overview';
const WatchRow = compact ? 'span' : 'button';
const values = Array.from({ length: 43 }, (_, i) => 197 - i * 2 + Math.sin(i * .71) * 21 + Math.cos(i * .31) * 16);
const points = values.map((y, i) => `${30 + i * 12},${y}`).join(' ');
const suffix = Math.random().toString(36).slice(2, 8);
---
<figure class:list={['visual', `visual-${kind}`, { compact }]} data-visual={kind}>
  <div class="visual-top"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{kind === 'statistics' ? 'TRADING ARCHIVE' : kind === 'mapper' ? 'SYMBOL CONNECTION' : kind === 'tabs' ? 'BROWSER WORKSPACE' : kind === 'ai' ? 'SAVED QUESTIONS' : kind === 'watchlist' ? 'WATCHLIST' : kind === 'links' ? 'CHART NAVIGATION' : 'CHART WORKSPACE'}</span><span class="sample-tag">{diagram ? "DIAGRAM" : "ILLUSTRATIVE"}</span></div>
  <div class="visual-stage">
  {chart && <>
    <div class="chart-heading"><span><b>NVDA</b><small>CFD · 5 min</small></span><span class="chart-value">124.80 <em>+1.20%</em></span></div>
    <div class="chart-wrap">
      <svg class="candle-chart" viewBox="0 0 600 290" role="img" aria-label="Illustrative price chart with synthetic values, not market data">
        <defs><linearGradient id={`fill-${suffix}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#68d4c3" stop-opacity=".17"/><stop offset="100%" stop-color="#68d4c3" stop-opacity="0"/></linearGradient></defs>
        {[40,95,150,205,260].map(y=><line x1="16" y1={y} x2="575" y2={y} stroke="currentColor" opacity=".07"/>)}
        {[80,180,280,380,480].map(x=><line x1={x} y1="15" x2={x} y2="265" stroke="currentColor" opacity=".05"/>)}
        {values.map((y,i)=>{const up=i===0||y<values[i-1];return <g class="candle" style={`--i:${i}`} stroke={up?'#72cfbd':'#dd898b'}><line x1={30+i*12} y1={y-15} x2={30+i*12} y2={y+18}/><rect x={26+i*12} y={y-5} width="8" height={9+(i%4)*3} fill={up?'#72cfbd':'#dd898b'} stroke="none" rx="1"/></g>})}
        {chart && <><path d={`M30,260 L${points.replaceAll(' ', ' L')} L534,260 Z`} fill={`url(#fill-${suffix})`}/><polyline class="draw-line" points={points} transform="translate(0,18)" fill="none" stroke="#82aef3" stroke-width="2"/><text x="390" y="257" fill="#82aef3" font-size="10">Real VWAP · CFD price</text></>}
        {chart && <g class="level-lines">{[{y:65,label:'+1.0%',color:'#72cfbd'},{y:130,label:'0.0% basis',color:'#b8c0d1'},{y:210,label:'−1.0%',color:'#dd898b'}].map(({y,label,color})=><><line x1="32" y1={y} x2="553" y2={y} stroke={color} stroke-dasharray="3 5" opacity=".7"/><rect x="488" y={y-10} width="85" height="21" rx="4" fill="#19222e"/><text x="495" y={y+4} fill={color} font-size="11">{label}</text></>)}</g>}
        <text x="22" y="283" fill="#8390a2" font-size="10">09:30</text><text x="252" y="283" fill="#8390a2" font-size="10">11:00</text><text x="512" y="283" fill="#8390a2" font-size="10">12:30</text>
      </svg>
      {chart && <div class="info-float"><div class="mini-label">UNDERLYING CONTEXT</div><b>NVIDIA Corporation</b><div><span>Native symbol</span><strong>NASDAQ:NVDA</strong></div><div><span>Daily ATR</span><strong>2.84%</strong></div><div><span>YTD</span><strong class="positive">+18.6%</strong></div><div><span>Earnings</span><strong>In 8 days</strong></div><small>Example values</small></div>}
    </div>
    {chart&&<div class="chart-key"><span>+1.0% upper level</span><span>0% basis</span><span>−1.0% lower level</span></div>}
  </>}
  {kind==='mapper'&&<div class="mapper-demo"><div class="mini-label">ONE PAIR. TWO CONNECTED INPUTS.</div><div class="symbol-node"><span>CFD chart</span><strong>TRADENATION:NVDA.EX</strong></div><div class="connection" aria-hidden="true"><i></i><b>Map</b><i></i></div><div class="symbol-node native"><span>Mapped exchange symbol</span><strong>NASDAQ:NVDA</strong></div><div class="receiver"><span>Receiving indicator</span><div><code>1st code</code><b>Map: 1st code <em>✓</em></b></div><div><code>2nd code</code><b>Map: 2nd code <em>✓</em></b></div></div><small>Connect both inputs from the same Map instance. Keep Map on this chart.</small><p class="diagram-note diagram-detail">Map shares the symbol identity. The receiving indicator requests the data. Local mappings and formulas take priority.</p></div>}
  {kind==='volume'&&<div class="explanation"><div class="diagram-branches"><div><div class="mini-label">STOCKS</div><div class="diagram-node"><b>{compact ? "NVDA.EX" : "TRADENATION:NVDA.EX"}</b><span>Trade Nation CFD chart</span></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><span>Volume source</span><b>NASDAQ:NVDA</b></div></div><div><div class="mini-label">INDICES</div><div class="diagram-node"><b>TRADENATION:USTEC</b><span>CFD chart</span></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><b>MNQ × 1 + NQ × 10 + QQQ × 60</b><span>Weighted activity proxy</span></div></div></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node accent-node"><b>External volume columns</b><div class="volume-bars" aria-hidden="true">{values.slice(0,25).map((_,i)=><i style={`height:${15+(i*23)%45}px;--i:${i}`}></i>)}</div></div><div class="diagram-detail"><div class="formula-strip"><code>CME_MINI:MNQ1! · CME_MINI:NQ1! · NASDAQ:QQQ</code></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><span>Selected external volume + CFD chart price</span><b>Real VWAP</b></div><p class="diagram-note">CFD prices weighted by the selected external volume. Weights are configurable. Index volume is an activity proxy.</p></div></div>}
  {kind==='levels' &&<div class="explanation"><div class="mini-label">WORKED EXAMPLE</div><div class="diagram-branches"><div class="diagram-node"><b>TRADENATION:USTEC</b><span>CFD price 20,240</span></div><div class="diagram-node"><b>NASDAQ:QQQ</b><span>Daily change +1.20%</span></div></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node accent-node"><span>0% basis</span><b>20,240 ÷ 1.012 = 20,000</b></div><svg class="worked-levels" viewBox="0 0 320 160" role="img" aria-label="Worked example: current price 20,240 above the plus 1 percent level at 20,200, basis 20,000 and minus 1 percent level 19,800"><line x1="12" y1="20" x2="308" y2="20" stroke="#9fe870"/><text x="18" y="15" fill="#9fe870">Current price 20,240 · +1.20%</text>{[{y:52,t:'+1% · 20,200',c:'#83deca'},{y:96,t:'0% · 20,000',c:'#c6d0dd'},{y:140,t:'−1% · 19,800',c:'#f09b9d'}].map(r=><g><line x1="12" y1={r.y} x2="308" y2={r.y} stroke={r.c} stroke-dasharray="4 5"/><text x="18" y={r.y-6} fill={r.c}>{r.t}</text></g>)}</svg><p class="diagram-note diagram-detail">The reference move sets the CFD basis at the first valid live snapshot. Levels stay fixed while the price label moves. This example uses chosen ±1% levels.</p></div>}
  {kind==='info'&&<div class="explanation"><div class="diagram-node"><span>CFD chart</span><b>TRADENATION:NVDA.EX</b></div><div class="flow-arrow">↓ <small>Local mapping or Map</small></div><div class="diagram-node accent-node"><b>NASDAQ:NVDA</b></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="info-groups"><span>Company</span><span>Earnings</span><span>Analyst targets and P/E</span><span>Price metrics</span></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><b>Selected rows beside your CFD candles</b></div><p class="diagram-note diagram-detail">Choose the rows you need. Info requests available data for the resolved symbol. This CFD example needs a configured mapping.</p></div>}
  {kind==='watchlist'&&<div class="watchlist-demo"><div class="mini-label">EXAMPLE VALUES</div><div class="list-head"><span>Symbol</span><span>Last</span></div><div class="watch-example-label">Extended session</div><div class="watch-row"><div class="watch-symbol"><b>NVDA</b><WatchRow type={compact?undefined:'button'} class="watch-badge" aria-pressed={compact?undefined:'false'} aria-label="NVDA example: reveal extended session price"><span class="percentage positive">+1.20%</span><span class="price">126.30</span></WatchRow></div><span>124.80</span></div><div class="watch-example-label">No extended session data</div><WatchRow type={compact?undefined:'button'} class="watch-row ordinary-row" aria-pressed={compact?undefined:'false'} aria-label="USTEC example: reveal Last price beside symbol"><span class="watch-symbol"><b>USTEC</b><span class="row-price">20,240</span></span><span>20,240</span></WatchRow><p class="diagram-note">Hover the badge for its calculated price. Without extended data, hover the row for Last.</p><p class="diagram-note diagram-detail">Interactive website example. Focus or tap also reveals the price here. The userscript runs in a desktop browser.</p></div>}
  {kind==='tabs'&&<div class="tabs-demo"><div class="mini-label">GLOBAL TEMPLATE</div><div class="template-demo"><code>&lt;layout&gt; · &lt;symbol&gt;</code><span class="flow-arrow" aria-hidden="true">↓</span></div><div class="browser-tabs named-tabs"><span>Stocks · NVDA</span><span>Stocks · AAPL</span></div><div class="template-demo"><span>THIS TAB OVERRIDE</span><code>Focus · &lt;symbol&gt;</code><span class="flow-arrow" aria-hidden="true">↓</span></div><div class="browser-tabs named-tabs"><span>Focus · NVDA</span><span>Stocks · AAPL</span></div><p class="diagram-note diagram-detail">One shared template. A separate override for any tab. Clear the override to use the global template.</p></div>}
  {kind==='ai'&&<div class="explanation"><div class="diagram-branches"><div class="diagram-node"><span>Chart toolbar symbol</span><b>NVDA</b></div><div class="diagram-node"><span>Saved question</span><b>Why has TICKER stock moved right now?</b></div></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="question-box"><div class="mini-label">PREPARED QUESTION</div>Why has <strong>NVDA</strong> stock moved right now?</div><div class="flow-arrow" aria-hidden="true">↓</div><div class="info-groups"><span>✓ ChatGPT</span><span>✓ Perplexity</span></div><p class="diagram-note">One background tab per selected service.</p><p class="diagram-note diagram-detail">Right click the chart symbol button. Choose a saved question and the services to open. Each service may require sign in or confirmation.</p></div>}
  {kind==='links'&&<div class="links-demo"><div class="mini-label">RECOGNISED CANVAS TEXT</div><div class="ticker-cloud"><span class="selected-ticker">NASDAQ:NVDA <i aria-hidden="true">↗</i></span></div><p class="diagram-note">Hover to see the outline</p><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-branches"><div class="diagram-node"><span>Click</span><b>Current chart</b></div><div class="diagram-node"><span>Ctrl or Command + click</span><b>New tab</b></div></div><p class="diagram-note diagram-detail">Open the chart from a recognised ticker drawn on a canvas. Supported prefixes only. Link opening can be configured.</p></div>}
  {kind==='statistics'&&<div class="explanation"><div class="mini-label">SIGNED IN TO TRADE NATION</div><div class="info-groups"><span>CFD · USD account</span><span>Spread · USD account</span></div><div class="flow-arrow">↓ <small>Pull history</small></div><div class="diagram-node accent-node"><b>Archive in this browser profile</b></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><b>Review overview, calendar and transactions</b></div><div class="diagram-detail"><div class="diagram-branches"><div class="diagram-node"><span>Archive + broker export</span><b>Compare records and fields</b><span>Review coverage and differences</span></div><div class="diagram-node"><span>From the archive</span><b>JSON backup</b></div></div><p class="diagram-note">Collect at the broker. Review the saved archive on another HTTPS page. No automatic background collection or cloud sync.</p><div class="formula-strip"><code>Closed P/L + booked adjustments = total return</code></div><p class="diagram-note">USD cash result. Deposits and withdrawals excluded.</p></div></div>}

  {kind==='hotkeys'&&<div class="explanation"><div class="keys-strip"><span>You press</span><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>B</kbd></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><b>Configured market buy request</b></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node"><b>Broker accepts or rejects the request</b></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="diagram-node accent-node"><b>Position overlay when available</b><span>Entry · Stop loss</span><span>Take profit, if configured or added later</span></div><div class="diagram-detail"><div class="keys-strip"><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>E</kbd></div><p class="diagram-note">Move the selected stop to the configured offset from entry.</p><p class="diagram-note">Manual shortcuts for the current broker chart. The overlay displays the position and cannot be dragged.</p></div></div>}

  </div>
  <figcaption><span class="illustration-label"><i aria-hidden="true"></i>{diagram || "Illustrative mockup, not actual product output"}</span>{!diagram&&!compact&&capture&&<span class="capture-note"><strong>Real capture needed:</strong> {capture}</span>}</figcaption>
</figure>
