---
interface Props { kind: string; capture?: string; compact?: boolean; }
const { kind, capture, compact = false } = Astro.props;
const chartKinds = ['overview', 'levels', 'volume', 'info', 'hotkeys'];
const chart = chartKinds.includes(kind);
const WatchRow = compact ? 'span' : 'button';
const values = Array.from({ length: 43 }, (_, i) => 197 - i * 2 + Math.sin(i * .71) * 21 + Math.cos(i * .31) * 16);
const points = values.map((y, i) => `${30 + i * 12},${y}`).join(' ');
const suffix = Math.random().toString(36).slice(2, 8);
---
<figure class:list={['visual', `visual-${kind}`, { compact }]} data-visual={kind}>
  <div class="visual-top"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{kind === 'statistics' ? 'TRADING ARCHIVE' : kind === 'mapper' ? 'SYMBOL CONNECTION' : kind === 'tabs' ? 'BROWSER WORKSPACE' : kind === 'ai' ? 'SAVED QUESTIONS' : kind === 'watchlist' ? 'WATCHLIST' : kind === 'links' ? 'CHART NAVIGATION' : 'CHART WORKSPACE'}</span><span class="sample-tag">ILLUSTRATIVE</span></div>
  <div class="visual-stage">
  {chart && <>
    <div class="chart-heading"><span><b>{kind === 'levels' ? 'USTEC' : 'NVDA'}</b><small>CFD · 5 min</small></span><span class="chart-value">{kind === 'levels' ? '20,240.0' : '124.80'} <em>+1.20%</em></span></div>
    <div class="chart-wrap">
      <svg class="candle-chart" viewBox="0 0 600 290" role="img" aria-label="Illustrative price chart with synthetic values, not market data">
        <defs><linearGradient id={`fill-${suffix}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#68d4c3" stop-opacity=".17"/><stop offset="100%" stop-color="#68d4c3" stop-opacity="0"/></linearGradient></defs>
        {[40,95,150,205,260].map(y=><line x1="16" y1={y} x2="575" y2={y} stroke="currentColor" opacity=".07"/>)}
        {[80,180,280,380,480].map(x=><line x1={x} y1="15" x2={x} y2="265" stroke="currentColor" opacity=".05"/>)}
        {values.map((y,i)=>{const up=i===0||y<values[i-1];return <g class="candle" style={`--i:${i}`} stroke={up?'#72cfbd':'#dd898b'}><line x1={30+i*12} y1={y-15} x2={30+i*12} y2={y+18}/><rect x={26+i*12} y={y-5} width="8" height={9+(i%4)*3} fill={up?'#72cfbd':'#dd898b'} stroke="none" rx="1"/></g>})}
        {(kind === 'volume' || kind === 'overview') && <><path d={`M30,260 L${points.replaceAll(' ', ' L')} L534,260 Z`} fill={`url(#fill-${suffix})`}/><polyline class="draw-line" points={points} transform="translate(0,18)" fill="none" stroke="#82aef3" stroke-width="2"/><text x="390" y="257" fill="#82aef3" font-size="10">Real VWAP · CFD price</text></>}
        {(kind==='levels'||kind==='overview') && <g class="level-lines">{[{y:65,label:'+1.0%',color:'#72cfbd'},{y:130,label:'0.0% basis',color:'#b8c0d1'},{y:210,label:'−1.0%',color:'#dd898b'}].map(({y,label,color})=><><line x1="32" y1={y} x2="553" y2={y} stroke={color} stroke-dasharray="3 5" opacity=".7"/><rect x="488" y={y-10} width="85" height="21" rx="4" fill="#19222e"/><text x="495" y={y+4} fill={color} font-size="11">{label}</text></>)}</g>}
        {kind==='hotkeys' && <g>{[{y:80,label:'TP · 126.00',color:'#72cfbd'},{y:146,label:'BUY · 124.00',color:'#82aef3'},{y:215,label:'SL · 122.00',color:'#dd898b'}].map(({y,label,color})=><><line x1="20" y1={y} x2="565" y2={y} stroke={color} stroke-dasharray="4 4"/><text x="445" y={y-7} font-size="11" fill={color}>{label}</text></>)}</g>}
        <text x="22" y="283" fill="#8390a2" font-size="10">09:30</text><text x="252" y="283" fill="#8390a2" font-size="10">11:00</text><text x="512" y="283" fill="#8390a2" font-size="10">12:30</text>
      </svg>
      {(kind==='info'||kind==='overview') && <div class="info-float"><div class="mini-label">UNDERLYING CONTEXT</div><b>NVIDIA Corporation</b><div><span>Native symbol</span><strong>NASDAQ:NVDA</strong></div><div><span>Daily ATR</span><strong>2.84%</strong></div><div><span>YTD</span><strong class="positive">+18.6%</strong></div><div><span>Earnings</span><strong>In 8 days</strong></div><small>Example values</small></div>}
    </div>
    {kind==='volume'&& <><div class="volume-bars" aria-hidden="true">{values.map((_,i)=><i style={`height:${15+(i*23)%65}px;--i:${i}`}></i>)}</div><div class="formula-strip"><span>STOCK SOURCE</span><code>TRADENATION:NVDA.EX → NASDAQ:NVDA</code></div></>}
    {(kind==='levels'||kind==='overview')&&<div class="chart-key"><span>+1.0% upper level</span><span>0% basis</span><span>−1.0% lower level</span></div>}
    {kind==='hotkeys'&&<div class="chart-key"><span>TP · 126.00</span><span>Entry · 124.00</span><span>SL · 122.00</span></div>}
    {kind==='hotkeys'&&<div class="keys-strip"><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>B</kbd><span>Market buy · demo illustration only</span></div>}
  </>}
  {kind==='mapper'&&<div class="mapper-demo"><div class="mini-label">ONE PAIR. TWO CONNECTED INPUTS.</div><div class="symbol-node"><span>CFD chart</span><strong>TRADENATION:NVDA.EX</strong></div><div class="connection" aria-hidden="true"><i></i><b>Map</b><i></i></div><div class="symbol-node native"><span>Underlying share</span><strong>NASDAQ:NVDA</strong></div><div class="receiver"><span>Receiving indicator</span><div><code>1st code</code><b>Map: 1st code <em>✓</em></b></div><div><code>2nd code</code><b>Map: 2nd code <em>✓</em></b></div></div><small>Connect once. Keep Map on this chart.</small></div>}
  {kind==='watchlist'&&<div class="watchlist-demo"><div class="list-head"><span>Symbol</span><span>Last</span><span>Extended</span></div>{[{s:'NVDA',p:'124.80',c:'+1.20%',v:'126.30',up:true},{s:'AAPL',p:'210.50',c:'−0.42%',v:'209.62',up:false},{s:'MSFT',p:'428.10',c:'+0.68%',v:'431.01',up:true},{s:'USTEC',p:'20,240',c:'Last price',v:'20,240',up:true}].map(r=><WatchRow type={compact ? undefined : "button"} class="watch-row" aria-pressed={compact ? undefined : "false"} aria-label={`Illustrative ${r.s}: hover, focus or tap to show price`}><b>{r.s}<i> {r.s==='USTEC'?'CFD':'Share'}</i></b><span>{r.p}</span><strong class:list={[r.up?'positive':'negative','hover-value']}><span class="percentage">{r.c}</span><span class="price">{r.v}</span></strong></WatchRow>)}<div class="demo-hint"><span aria-hidden="true">↖</span> Hover, focus or tap a row to reveal its example price</div></div>}
  {kind==='tabs'&&<div class="tabs-demo"><div class="mini-label">BEFORE</div><div class="browser-tabs muted-tabs"><span>NVDA 124.80...</span><span>AAPL 210.50...</span><span>USTEC 20240...</span></div><div class="template-demo"><span>YOUR GLOBAL TEMPLATE</span><code>&lt;layout&gt; · &lt;symbol&gt;</code><span class="flow-arrow" aria-hidden="true">↓</span></div><div class="mini-label positive">AFTER</div><div class="browser-tabs named-tabs"><span>Stocks · NVDA</span><span>Stocks · AAPL</span><span>Indices · USTEC</span></div><p>One shared template.<br/><b>An override for any individual tab.</b></p></div>}
  {kind==='ai'&&<div class="ai-demo"><div class="ai-symbol"><span class="symbol-icon">N</span><div><b>NVDA</b><small>Current chart symbol</small></div></div><div class="question-box">Why has <strong>NVDA</strong> stock moved right now? Is there a catalyst?</div><div class="ai-services"><span>✓ ChatGPT</span><span>✓ Perplexity</span><span>Grok</span></div><div class="mock-action"><span>Saved question</span><b>Open with this symbol <span aria-hidden="true">↗</span></b></div><small class="demo-hint">Prepared question, not an automatically verified answer.</small></div>}
  {kind==='links'&&<div class="links-demo"><div class="mini-label">TICKER TEXT ON A CANVAS</div><div class="ticker-cloud"><span>NYSE:SHOP</span><span class="selected-ticker">NASDAQ:NVDA <i aria-hidden="true">↗</i></span><span>IG:AAPL</span></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="link-destination"><span class="symbol-icon">N</span><div><b>NVDA chart</b><small>Same tab, or a new one</small></div><span aria-hidden="true">↗</span></div><div class="keys-strip"><kbd>Shift</kbd><span>+ click</span><small>Open in a new tab</small></div></div>}
  {kind==='statistics'&&<div class="stats-demo"><div class="mini-label">EXAMPLE ARCHIVE · SYNTHETIC VALUES</div><div class="stats-metrics"><div><span>Closed P/L</span><b>$240.00</b></div><div><span>Adjustments</span><b>−$18.00</b></div><div><span>Total return</span><b class="positive">$222.00</b></div></div><svg viewBox="0 0 560 140" role="img" aria-label="Illustrative archive chart, not actual performance"><path d="M10 115 L45 109 L80 115 L115 88 L150 99 L185 77 L220 82 L255 55 L290 65 L325 36 L360 43 L395 31 L430 52 L465 28 L500 32 L545 15" stroke="#73d4c3" stroke-width="3" fill="none" class="draw-line"/><line x1="10" y1="130" x2="550" y2="130" stroke="#8493a6" opacity=".2"/></svg><div class="calendar-mini" aria-label="Illustrative calendar">{Array.from({length:21},(_,i)=><div class:list={[i%7===0?'empty':i%4===0?'loss':'gain']}><small>{i+1}</small><b>{i%7===0?'—':i%4===0?'−12':'+24'}</b></div>)}</div><small>Cash result includes booked adjustments. Deposits excluded.</small></div>}
  </div>
  <figcaption><span class="illustration-label"><i aria-hidden="true"></i>Illustrative mockup, not actual product output</span>{!compact&&capture&&<span class="capture-note"><strong>Real capture needed:</strong> {capture}</span>}</figcaption>
</figure>
