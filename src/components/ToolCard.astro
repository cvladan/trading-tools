---
import type { CollectionEntry } from 'astro:content';
import Visual from './Visual.astro';
interface Props { tool: CollectionEntry<'tools'>; volumeMarket?: 'stocks' | 'indices'; }
const {tool,volumeMarket}=Astro.props;
---
<article class="tool-card" data-reveal>
<div class="card-content"><div class="card-meta"><span>{tool.data.label}</span><span class="card-number">{String(tool.data.order).padStart(2,'0')}</span></div><h3><a href={`/tools/${tool.id}/`}>{tool.data.name.replace('SVKO ', '')}</a></h3><p>{tool.data.summary}</p><a class="text-link" href={`/tools/${tool.id}/`}>See how it works <span aria-hidden="true">↗</span></a></div>
<a class="card-visual-link" href={`/tools/${tool.id}/`} tabindex="-1" aria-hidden="true"><Visual kind={tool.data.visual} diagram={tool.data.diagram} volumeMarket={volumeMarket} compact/></a>
</article>
